{
  "info": {
    "_postman_id": "6f7ef1f2-51d7-4fef-9f38-tictactoe-springboot",
    "name": "TicTacToe Spring Boot API",
    "description": "Postman collection for the Spring Boot Tic-Tac-Toe backend.\n\nRecommended order:\n1. Create Player X\n2. Create Player O\n3. Create Room\n4. Join Room\n5. Play the sample moves\n6. Check Leaderboard\n7. Create Rematch Game\n\nThe collection automatically stores playerXId, playerOId, roomCode, and gameId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
