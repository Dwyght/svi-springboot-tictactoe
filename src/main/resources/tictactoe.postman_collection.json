  "item": [
    {
      "name": "01 - Players",
      "item": [
        {
          "name": "1. Create Player X",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/players",
            "description": "Creates the room owner. The returned playerId is saved as playerXId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"PLAYER X\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is successful\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const body = pm.response.json();",
                  "pm.expect(body.playerId).to.exist;",
                  "pm.collectionVariables.set(\"playerXId\", body.playerId);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Create Player O",
