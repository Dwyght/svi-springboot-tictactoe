      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "playerXId",
      "value": ""
    },
    {
      "key": "playerOId",
      "value": ""
    },
    {
      "key": "roomCode",
      "value": ""
    },
    {
      "key": "gameId",
      "value": ""
    }
